# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# production hides Swagger, the GeoServer web UI and the /admin page.
# development exposes them (see README.md for details).
APP_PROFILE=production

# Postgres credentials — CHANGE THESE before deploying anywhere reachable
# from outside your own machine. Used by both the postgres container and
# the backend's datasource.
POSTGRES_USER=seismap
POSTGRES_PASSWORD=change-me

# GeoServer admin credentials — CHANGE THESE too. Used by the geoserver
# container itself and by the backend (GeoServerAutoConfigService/MapController)
# to authenticate against GeoServer's REST API.
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change-me
